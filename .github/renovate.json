{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":automergeStableNonMajor",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "group:allNonMajor",
    "workarounds:all"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": ["* 10-17 * * 5"],
  "labels": ["dependencies"],
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "✨ VitePress & Vue Core",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^vitepress$/", "/^vue$/"]
    }
  ]
}
